# Copy to .env and fill in. .env is gitignored; this file is the template.

# VPN gateway (written into the client profile on container start)
VPN_SERVER_IP=your_gateway_ip
VPN_SERVER_PORT=your_gateway_port

# CLI login. Required.
VPN_USERNAME=your_username
VPN_PASSWORD=your_password

# Optional profile file name under the mounted config directory.
# VPN_PROFILE_NAME=default.ini

# Optional container MAC address. run-cli.sh reads this from the host environment,
# not from the container, so export it before ./run-cli.sh if you need it.
# SPOOF_MAC=00:1A:2B:3C:4D:5E

# Auto-reconnect. The entrypoint default is true when unset.
AUTO_RECONNECT=true
RECONNECT_PING_TARGET=8.8.8.8
RECONNECT_GRACE_PERIOD=60
HEALTH_CHECK_INTERVAL=10
RETRY_DELAY=5

# Interface Dante waits for after the tunnel comes up.
# DANTE_INTERFACE=cnem_vnic
